{
  "name": "bb-plugin-template-esbuild",
  "version": "1.0.0",
  "description": "A template for building Blockbench plugins using Typescript and esbuild",
  "main": "src/plugin.ts",
  "type": "module",
  "scripts": {
    "build": "esbuild src/plugin.ts --bundle --outfile=dist/my_plugin.js",
    "dev": "esbuild src/plugin.ts --bundle --outfile=dist/my_plugin.js --watch"
  },
  "author": "JannisX11",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "blockbench-types": "^5.2.1",
    "typescript": "^7.0.2"
  }
}
